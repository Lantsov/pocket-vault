<Window x:Class="PocketVault.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="PocketVault" Width="680" Height="620" MinWidth="560" MinHeight="480"
        Background="#141414" Foreground="#F5F5F5" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterScreen"
        AllowDrop="True" PreviewDragOver="FileDragOver" PreviewDragLeave="FileDragLeave" PreviewDrop="FileDrop"
        Closing="WindowClosing" Closed="WindowClosed" Loaded="WindowLoaded">
    <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="Theme.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></Window.Resources>
    <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
    <Border BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Background="#141414" TextElement.Foreground="#F5F5F5">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0,8,0">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource LockIcon}" Stroke="#F5F5F5" StrokeThickness="1.8" Width="17" Height="22" Stretch="Uniform" Margin="0,0,12,0" />
                        <TextBlock Text="PocketVault" FontWeight="SemiBold" FontSize="18" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Настройки · файлы .pvlt" AutomationProperties.Name="Настройки" Click="SettingsClick" Margin="0,0,8,0">
                            <Path Data="M9,1 L12,1 13,4 16,5 19,4 21,7 19,10 19,13 21,16 19,19 16,18 13,19 12,22 9,22 8,19 5,18 2,19 0,16 2,13 2,10 0,7 2,4 5,5 8,4 Z M15,11.5 A4.5,4.5 0 1 1 6,11.5 A4.5,4.5 0 1 1 15,11.5" Stroke="#A0A0A0" StrokeThickness="1.5" Stretch="Uniform" />
                        </Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Свернуть" AutomationProperties.Name="Свернуть" Click="MinimizeClick"><Path Data="M0,5 H12" Stroke="#F5F5F5" StrokeThickness="1.3" /></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Развернуть или восстановить" AutomationProperties.Name="Развернуть или восстановить" Click="MaximizeClick"><Rectangle Width="11" Height="11" Stroke="#F5F5F5" StrokeThickness="1.3" RadiusX="1" RadiusY="1" /></Button>
                        <Button Style="{StaticResource IconButton}" ToolTip="Закрыть" AutomationProperties.Name="Закрыть" Click="CloseClick"><Path Data="{StaticResource CloseIcon}" Stroke="#F5F5F5" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" /></Button>
                    </StackPanel>
                </Grid>
            </Border>
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,16,24,16">
                <Grid x:Name="Body">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                    <TextBlock Text="Один файл. Один пароль. Всё под вашим контролем." Foreground="{StaticResource Muted}" Margin="0,0,0,16" />
                    <Grid x:Name="InputPanel" Grid.Row="1">
                        <StackPanel>
                            <Button x:Name="BrowseButton" Height="112" Background="Transparent" BorderThickness="0" Padding="0" Click="BrowseClick" AutomationProperties.Name="Выбрать или перетащить файл">
                                <Button.Template><ControlTemplate TargetType="Button">
                                    <Grid Background="Transparent">
                                        <Rectangle x:Name="DropOutline" RadiusX="12" RadiusY="12" Stroke="#606060" StrokeDashArray="3 3" StrokeThickness="1" Fill="{TemplateBinding Background}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="DropOutline" Property="Stroke" Value="#F5F5F5" /><Setter TargetName="DropOutline" Property="Fill" Value="#1E1E1E" /></Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="DropOutline" Property="Stroke" Value="#F5F5F5" /></Trigger>
                                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.36" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate></Button.Template>
                                <StackPanel>
                                    <Path Data="{StaticResource FileIcon}" Stroke="#F5F5F5" StrokeThickness="1.5" Width="24" Height="30" Stretch="Uniform" Margin="0,0,0,8" />
                                    <TextBlock Text="Перетащите сюда один файл" FontSize="15" HorizontalAlignment="Center" /><TextBlock Text="или нажмите, чтобы выбрать · до 128 МиБ" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Border x:Name="FileCard" Height="52" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,8,8,8" Margin="0,12,0,16">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="32" /><ColumnDefinition Width="*" /><ColumnDefinition Width="36" /></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource FileIcon}" Stroke="#A0A0A0" StrokeThickness="1.5" Width="20" Height="26" Stretch="Uniform" HorizontalAlignment="Left" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="FileNameText" Text="Файл не выбран" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="FileDetailText" Text="Выберите файл или контейнер .pvlt" Foreground="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                                    </StackPanel>
                                    <Button x:Name="ClearButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="ClearClick" ToolTip="Убрать выбранный файл" AutomationProperties.Name="Убрать выбранный файл" IsEnabled="False"><Path Data="{StaticResource CloseIcon}" Stroke="#A0A0A0" StrokeThickness="1.3" Width="12" Height="12" Stretch="Uniform" /></Button>
                                </Grid>
                            </Border>
                            <Label Content="_Пароль" Target="{Binding ElementName=Password}" Padding="0" Margin="0,0,0,4" Foreground="#F5F5F5" />
                            <Border Style="{StaticResource PasswordFrame}">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="40" /></Grid.ColumnDefinitions>
                                    <Path Data="{StaticResource LockIcon}" Stroke="#A0A0A0" StrokeThickness="1.5" Width="14" Height="18" Stretch="Uniform" />
                                    <PasswordBox x:Name="Password" Grid.Column="1" PasswordChanged="PasswordChanged" AutomationProperties.Name="Пароль" />
                                    <TextBox x:Name="VisiblePassword" Grid.Column="1" Visibility="Collapsed" TextChanged="VisiblePasswordChanged" AutomationProperties.Name="Пароль открытым текстом" />
                                    <Button x:Name="ShowPasswordButton" Grid.Column="2" Style="{StaticResource IconButton}" Click="ShowPasswordClick" ToolTip="Показать пароль" AutomationProperties.Name="Показать пароль"><Path Data="{StaticResource EyeIcon}" Stroke="#A0A0A0" StrokeThickness="1.5" Width="19" Height="16" Stretch="Uniform" /></Button>
                                </Grid>
                            </Border>
                            <StackPanel x:Name="ConfirmationPanel" Margin="0,8,0,0">
                                <Label Content="П_овторите пароль" Target="{Binding ElementName=Confirmation}" Padding="0" Foreground="#F5F5F5" Margin="0,0,0,4" />
                                <Border Style="{StaticResource PasswordFrame}">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <Path Data="{StaticResource LockIcon}" Stroke="#A0A0A0" StrokeThickness="1.5" Width="14" Height="18" Stretch="Uniform" />
                                        <PasswordBox x:Name="Confirmation" Grid.Column="1" PasswordChanged="PasswordChanged" AutomationProperties.Name="Повторите пароль" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                            <CheckBox x:Name="DeleteOriginal" Margin="0,12,0,16" Checked="DeleteChanged" Unchecked="DeleteChanged" AutomationProperties.Name="Удалить исходник после проверки контейнера">
                                <StackPanel><TextBlock Text="Удалить исходник после проверки контейнера" FontSize="12" /><TextBlock Text="Обычное удаление не уничтожает следы на диске." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" /></StackPanel>
                            </CheckBox>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="EncryptButton" Height="44" Background="#F5F5F5" Foreground="#141414" FontWeight="SemiBold" FontSize="14" Click="EncryptClick" IsEnabled="False" AutomationProperties.Name="Зашифровать">
                                    <StackPanel Orientation="Horizontal"><Path Data="{StaticResource LockIcon}" Stroke="#141414" StrokeThickness="1.8" Width="15" Height="20" Stretch="Uniform" Margin="0,0,12,0" /><TextBlock Text="Зашифровать" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                                <Button x:Name="DecryptButton" Grid.Column="2" Height="44" FontWeight="SemiBold" FontSize="14" Click="DecryptClick" IsEnabled="False" AutomationProperties.Name="Расшифровать">
                                    <StackPanel Orientation="Horizontal"><Path Data="M6,10 V6 A6,6 0 0 1 18,6 M4,10 H20 V23 H4 Z" Stroke="#F5F5F5" StrokeThickness="1.8" Width="15" Height="20" Stretch="Uniform" Margin="0,0,12,0" /><TextBlock Text="Расшифровать" VerticalAlignment="Center" /></StackPanel>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="StatusCard" Grid.Row="3" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="10" Padding="16,10" Margin="0,16,0,0" MinHeight="52" AutomationProperties.LiveSetting="Polite">
                        <StackPanel>
                            <TextBlock x:Name="StatusText" Text="Готов к работе" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <TextBlock x:Name="StatusDetail" Text="Полностью локально · формат .pvlt · до 128 МиБ" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0" TextWrapping="Wrap" />
                            <ProgressBar x:Name="OperationProgress" Style="{StaticResource ActivityProgress}" Height="3" IsIndeterminate="True" Visibility="Collapsed" Foreground="#F5F5F5" Background="#353535" BorderThickness="0" Margin="0,10,0,2" SizeChanged="ProgressSizeChanged" AutomationProperties.Name="Выполняется операция" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
