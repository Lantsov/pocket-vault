<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-android</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PocketVault.Android</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <SupportedOSPlatformVersion>29.0</SupportedOSPlatformVersion>
    <ApplicationId>com.lantsov.pocketvault</ApplicationId>
    <ApplicationTitle>PocketVault</ApplicationTitle>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <!-- Keep SDK publish/trim inference from adding the desktop host RID. -->
    <UseDefaultPublishRuntimeIdentifier>false</UseDefaultPublishRuntimeIdentifier>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <ProjectReference Include="../PocketVault.Core/PocketVault.Core.csproj" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#274A7A" BaseSize="128,128" />
    <MauiImage Include="../docs/images/pocketvault-logo.png" Link="Resources/Images/pocketvault_logo.png" />
    <EmbeddedResource Include="../PocketVault.Tests/Fixtures/v1-container.base64" LogicalName="PocketVault.Android.Fixtures.V1" />
    <EmbeddedResource Include="../PocketVault.Tests/Fixtures/v1.1.0-container.base64" LogicalName="PocketVault.Android.Fixtures.V110" />
  </ItemGroup>
</Project>
